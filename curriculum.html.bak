    <!-- JavaScript for Year Tabs and Expand/Collapse -->
    <script>
        // Year Tab Switching
        const yearTabs = document.querySelectorAll('.year-tab');
        const yearContents = document.querySelectorAll('.year-content');

        yearTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                // Remove active from all tabs and contents
                yearTabs.forEach(t => t.classList.remove('active'));
                yearContents.forEach(c => c.classList.remove('active'));
                
                // Add active to clicked tab and corresponding content
                tab.classList.add('active');
                const targetYear = tab.getAttribute('data-year');
                document.getElementById(targetYear).classList.add('active');
            });
        });

        // Expand/Collapse Synopsis
        const expandBtns = document.querySelectorAll('.expand-btn');

        expandBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                const synopsisRow = document.getElementById(targetId);
                const icon = btn.querySelector('i');
                
                // Toggle visibility
                if (synopsisRow.classList.contains('active')) {
                    synopsisRow.classList.remove('active');
                    icon.classList.remove('fa-minus');
                    icon.classList.add('fa-plus');
                } else {
                    synopsisRow.classList.add('active');
                    icon.classList.remove('fa-plus');
                    icon.classList.add('fa-minus');
                }
            });
        });
    </script>

