                    <input type="text" placeholder="Search...">
                    <button><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
        
        <nav class="main-nav">
            <div class="container">
                <ul class="nav-links">
                    <li><a href="index.html">Home</a></li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">UG Program <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="ug-info.html">Program Info</a></li>
                            <li><a href="ug-curriculum.html">Curriculum</a></li>
                            <li><a href="ug-admission.html">Admission</a></li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle active">PG Program <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="pg-info.html">Program Info</a></li>
                            <li><a href="pg-curriculum.html" class="active">Curriculum</a></li>
                            <li><a href="pg-admission.html">Admission</a></li>
