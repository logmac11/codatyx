                            <li><a href="wbl-courses.html">WBL Courses</a></li>
                            <li><a href="wbl-administration.html">WBL Administration</a></li>
                            <li><a href="wbl-cohorts.html">WBL Cohorts</a></li>
                            <!-- <li><a href="#">Industry Partners</a></li>
                            <li><a href="#">Student Testimonials</a></li> -->
                        </ul>
                    </li>
                    <li><a href="contact.html">Contact</a></li>
                    <li class="apply-btn"><a href="apply.html">Apply Now</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- ================= PAGE HERO BANNER ================= -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="breadcrumb">
                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>PG Program</span> <i class="fas fa-chevron-right"></i> 
                <span>Curriculum</span>
            </div>
            <h1>Postgraduate Curriculum</h1>
            <p>Coursework and Research Structure</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">
            
            <div class="construction-container">
                <div class="construction-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <h2>Curriculum Details Coming Soon</h2>
                <div class="title-underline" style="margin: 0 auto 20px auto;"></div>
                <p class="construction-text">
                    The detailed curriculum structure, course listings, and research milestones for the 
                    Master of Data Analytics and PhD programs are currently being finalized. 
                </p>
                <p class="construction-subtext">
                    For immediate access to the postgraduate course structure, please refer to the official UTHM postgraduate portal or contact the faculty office.
                </p>
                <div class="construction-actions">
                    <a href="index.html" class="btn btn-primary"><i class="fas fa-home"></i> Return Home</a>
                    <a href="https://wapps.uthm.edu.my/intake/" target="_blank" class="btn btn-outline"><i class="fas fa-external-link-alt"></i> Visit PG Portal</a>
                </div>
            </div>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">
        <div class="container footer-content">
            <div class="footer-links">
                <a href="#">University</a> | <a href="#">About CDA</a> | <a href="#">WBL</a> | <a href="#">Faculty</a> | <a href="#">Alumni</a> | <a href="#">Contact</a>
