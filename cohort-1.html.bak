			<div id="schedules" class="tab-content">
				
				<!-- Semester 2 Schedule -->
				<div class="schedule-block">
					<div class="schedule-header">
						<div class="schedule-icon"><i class="fas fa-calendar-week"></i></div>
						<div>
							<h3>Semester 2 (2025/2026)</h3>
							<p>WBL and Academic Session Timeline</p>
						</div>
					</div>
					
					<div class="table-responsive">
						<table class="schedule-table">
							<thead>
								<tr>
									<th style="width: 25%;">Date</th>
									<th style="width: 15%;">Week<br>(WBL Session)</th>
									<th style="width: 15%;">Week<br>(Academic Session)</th>
									<th style="width: 45%;">Matters</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>2/3/2026</td>
									<td class="text-center">1</td>
									<td class="text-center">-</td>
									<td>Students register to the industry</td>
								</tr>
								<tr>
									<td>8/3/2026</td>
									<td class="text-center">1</td>
									<td class="text-center">-</td>
									<td class="text-danger"><strong>Senior Student register courses</strong></td>
								</tr>
