<!-- ================= PASSWORD MODAL (Goes AFTER footer, BEFORE script) ================= -->
    <!-- Password Protection Modal -->
	<!-- Password Protection Modal -->
	<div id="passwordModal" class="modal-overlay">
		<div class="modal-box">
			<div class="modal-header">
				<i class="fas fa-shield-alt"></i>
				<h3>Authorized Access Only</h3>
			</div>
			<div class="modal-body">
				<p>Please enter the assessment passkey to proceed.</p>
				<input type="password" id="passkeyInput" placeholder="Enter passkey" onkeypress="handleEnter(event)">
				<p id="errorMsg" class="error-text">Incorrect passkey. Please try again.</p>
			</div>
			<div class="modal-footer">
				<!-- ADDED type="button" to prevent accidental form submission -->
				<button type="button" class="btn-modal cancel" onclick="closeModal()">Cancel</button>
				<button type="button" class="btn-modal submit" onclick="verifyPassword(event)">Unlock</button>
			</div>
		</div>
	</div>

    <!-- ================= SINGLE, CONSOLIDATED JAVASCRIPT BLOCK ================= -->
    <script>
        // ==========================================
        // 1. TAB FUNCTIONALITY
        // ==========================================
        function openTab(evt, tabName) {
            var tabContents = document.getElementsByClassName("tab-content");
            for (var i = 0; i < tabContents.length; i++) {
                tabContents[i].classList.remove("active");
            }
            var tabButtons = document.getElementsByClassName("tab-btn");
            for (var i = 0; i < tabButtons.length; i++) {
                tabButtons[i].classList.remove("active");
            }
            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
            window.location.hash = tabName;
        }
        
        window.addEventListener('load', function() {
            var hash = window.location.hash.substring(1);
            if (hash && document.getElementById(hash)) {
                var tabButton = document.querySelector('.tab-btn[onclick*="' + hash + '"]');
                if (tabButton) { tabButton.click(); }
            }
        });

        // ==========================================
        // 2. MOBILE DROPDOWN TOGGLE
        // ==========================================
        const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
        dropdownToggles.forEach(toggle => {
            toggle.addEventListener('click', (e) => {
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    const menu = toggle.nextElementSibling;
                    if (menu && menu.classList.contains('dropdown-menu')) {
                        menu.classList.toggle('show');
                    }
                }
            });
        });

        // ==========================================
        // 3. LOAD STUDENTS FROM JSON
        // ==========================================
        async function loadStudents() {
            try {
                const response = await fetch('students-data.json');
                const data = await response.json();
                const container = document.getElementById('student-table-container');
                
                const supervisorCounts = {};
                data.students.forEach(student => {
                    supervisorCounts[student.supervisor] = (supervisorCounts[student.supervisor] || 0) + 1;
                });

                let legendHTML = `<div class="supervisor-legend"><h4><i class="fas fa-palette"></i> Supervisor Color Guide</h4><div class="legend-items">`;
                const supervisorColors = {
                    "DR KEK SIE LONG": "legend-kek",
                    "DR. LOGENTHIRAN A/L MACHAP": "legend-logen",
                    "PM DR FAZLINA AMAN": "legend-fazlina",
                    "PM DR SITI SUHANA JAMAIAN": "legend-suhana",
                    "PM. DR. MOHD SAIFULLAH RUSIMAN": "legend-saifullah",
                    "PROF. DR. AZME KHAMIS": "legend-azme",
                    "TS. DR. WAN NOR MUNIRAH ARIFFIN": "legend-munirah"
                };

                Object.keys(supervisorCounts).forEach(sup => {
                    const colorClass = supervisorColors[sup] || '';
                    legendHTML += `<div class="legend-item ${colorClass}"><span class="legend-color"></span> ${sup} (${supervisorCounts[sup]})</div>`;
                });
                legendHTML += `</div></div>`;

                let tableHTML = `<div class="table-responsive"><table class="cohort-table color-coded"><thead><tr>
                    <th>No.</th><th>Student Name</th><th>Matric Number</th><th>Company/Industry</th>
                    <th>Industry Coordinator</th><th>Industry Coach</th><th>University Supervisor</th>
                </tr></thead><tbody>`;

                data.students.forEach((student, index) => {
                    let rowClass = '';
                    if (student.supervisor.includes('KEK')) rowClass = 'sup-kek';
                    else if (student.supervisor.includes('LOGENTHIRAN')) rowClass = 'sup-logen';
                    else if (student.supervisor.includes('FAZLINA')) rowClass = 'sup-fazlina';
                    else if (student.supervisor.includes('SITI SUHANA')) rowClass = 'sup-suhana';
                    else if (student.supervisor.includes('SAIFULLAH')) rowClass = 'sup-saifullah';
                    else if (student.supervisor.includes('AZME')) rowClass = 'sup-azme';
                    else if (student.supervisor.includes('MUNIRAH')) rowClass = 'sup-munirah';

                    tableHTML += `<tr class="${rowClass}">
                        <td>${index + 1}</td><td>${student.name}</td><td>${student.matric}</td>
                        <td>${student.company}</td><td>${student.coordinator}</td><td>${student.coach}</td>
                        <td><strong>${student.supervisor}</strong></td>
                    </tr>`;
                });
                tableHTML += `</tbody></table></div>`;
                container.innerHTML = legendHTML + tableHTML;

            } catch (error) {
                console.error('Error loading students:', error);
                document.getElementById('student-table-container').innerHTML = 
                    '<p style="color: red; text-align: center; padding: 20px;">Error loading student data. Please ensure students-data.json exists.</p>';
            }
        }

        // ==========================================
        // 4. LOAD SCHEDULES FROM JSON
        // ==========================================
        async function loadSchedules() {
            try {
                const response = await fetch('schedules-data.json');
                const data = await response.json();
                const container = document.getElementById('schedule-container');
                container.innerHTML = '';
                
                container.appendChild(createScheduleTable('Semester 2 (2025/2026)', 'fa-calendar-week', data.semester2));
                container.appendChild(createScheduleTable('Short Semester (2025/2026)', 'fa-bolt', data.shortSemester));
                container.appendChild(createScheduleTable('Semester 1 (2026/2027)', 'fa-calendar-week', data.semester1));
            } catch (error) {
                console.error('Error loading schedules:', error);
                document.getElementById('schedule-container').innerHTML = 
                    '<p style="color: red; text-align: center; padding: 20px;">Error loading schedule data. Please ensure schedules-data.json exists.</p>';
            }
        }

        function createScheduleTable(title, icon, rows) {
            const block = document.createElement('div');
            block.className = 'schedule-block';
            let html = `<div class="schedule-header"><div class="schedule-icon"><i class="fas ${icon}"></i></div>
                <div><h3>${title}</h3><p>WBL and Academic Session Timeline</p></div></div>
                <div class="table-responsive"><table class="schedule-table"><thead><tr>
                <th style="width: 25%;">Date</th><th style="width: 15%;">Week<br>(WBL session)</th>
                <th style="width: 15%;">Week<br>(Academic session)</th><th style="width: 45%;">Matters</th>
                </tr></thead><tbody>`;
            
            rows.forEach(row => {
                const highlightClass = row.highlight ? 'highlight-row' : '';
                html += `<tr class="${highlightClass}">
                    <td>${row.date}</td><td class="text-center">${row.weekWBL}</td>
                    <td class="text-center">${row.weekAcademic}</td><td>${row.matters}</td>
                </tr>`;
            });
            html += '</tbody></table></div>';
            block.innerHTML = html;
            return block;
        }

		// ==========================================
		// 5. PASSWORD PROTECTION LOGIC
		// ==========================================
		// ==========================================
		// 5. PASSWORD PROTECTION LOGIC (BULLETPROOF)
		// ==========================================
		let targetUrl = '';
		const correctPasskey = 'bwscohort1';

		function checkAccess(url) {
			console.log("1. checkAccess called with URL:", url);
			targetUrl = url;
			
			const modal = document.getElementById('passwordModal');
			const input = document.getElementById('passkeyInput');
			const errorMsg = document.getElementById('errorMsg');
			
			if (modal && input && errorMsg) {
				modal.classList.add('active');
				input.value = '';
				errorMsg.style.display = 'none';
				setTimeout(() => input.focus(), 100);
			} else {
				console.error("ERROR: Modal elements not found in HTML!");
			}
		}

		function verifyPassword(event) {
			if (event) event.preventDefault(); // Stop any default button behavior
			
			console.log("2. verifyPassword called");
			const input = document.getElementById('passkeyInput');
			const errorMsg = document.getElementById('errorMsg');
			const enteredPasskey = input.value;
			
			console.log("3. Entered:", enteredPasskey, "| Expected:", correctPasskey);
			
			if (enteredPasskey === correctPasskey) {
				console.log("4. Password CORRECT! Target URL:", targetUrl);
				
				if (!targetUrl) {
					alert("Error: No destination URL found.");
					return;
				}
				
				// Close modal immediately
				const modal = document.getElementById('passwordModal');
				if (modal) modal.classList.remove('active');
				
				// Force navigation
				console.log("5. Attempting to navigate to:", targetUrl);
				window.location.href = targetUrl;
				
			} else {
				console.log("4. Password INCORRECT!");
				if (errorMsg) {
					errorMsg.style.display = 'block';
					input.value = '';
					input.focus();
				}
			}
		}

		function closeModal() {
			console.log("closeModal called");
			const modal = document.getElementById('passwordModal');
			if (modal) modal.classList.remove('active');
			targetUrl = '';
		}

		function handleEnter(event) {
			if (event.key === 'Enter') {
				event.preventDefault();
				verifyPassword(event);
			}
		}

		// Close modal when clicking outside
		document.addEventListener('DOMContentLoaded', function() {
			const modal = document.getElementById('passwordModal');
			if (modal) {
				modal.addEventListener('click', function(e) {
					if (e.target === this) {
						closeModal();
					}
				});
			}
		});

        // ==========================================
        // 6. INITIALIZE ON PAGE LOAD
        // ==========================================
        document.addEventListener('DOMContentLoaded', function() {
            loadStudents();
            loadSchedules();
        });
    </script>

</body>
</html>