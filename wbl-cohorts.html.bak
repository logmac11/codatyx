    <!-- ================= PAGE HERO BANNER ================= -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="breadcrumb">
                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>WBL Experience</span> <i class="fas fa-chevron-right"></i> 
                <span>WBL Cohorts</span>
            </div>
            <h1>WBL Cohorts</h1>
            <p>Track and manage Work-Based Learning cohorts and their progress</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">

            <section class="section cohorts-section">
                <div class="section-header">
                    <span class="section-tag">Cohorts</span>
                    <h2>Active & Completed WBL Cohorts</h2>
                    <div class="title-underline"></div>
                    <p class="section-subtitle">Browse through different WBL cohorts to view student placements, industry partners, and project progress</p>
                </div>
                
                <div class="cohorts-grid">
                    
                    <!-- Cohort 1 Card -->
                    <div class="cohort-card">
                        <div class="cohort-header">
                            <div class="cohort-badge active">Active</div>
                            <h3>Cohort 1</h3>
                            <span class="cohort-year">2024/2025</span>
                        </div>
                        <div class="cohort-stats">
                            <div class="stat-item">
                                <i class="fas fa-users"></i>
                                <span class="stat-number">[26]</span>
                                <span class="stat-label">Students</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-building"></i>
                                <span class="stat-number">[20]</span>
                                <span class="stat-label">Companies</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-user-tie"></i>
                                <span class="stat-number">[7]</span>
                                <span class="stat-label">Supervisors</span>
                            </div>
                        </div>
                        <div class="cohort-details">
                            <p><strong>Duration:</strong> [02/03/2025] - [15/01/2026]</p>
                            <p><strong>Status:</strong> Currently in Semester [Short]</p>
                        </div>
                        <a href="cohort-1.html" class="btn btn-primary">View Details <i class="fas fa-arrow-right"></i></a>
                    </div>

                    <!-- Cohort 2 Card (Placeholder) -->
                    <div class="cohort-card">
                        <div class="cohort-header">
                            <div class="cohort-badge upcoming">Upcoming</div>
                            <h3>Cohort 2</h3>
                            <span class="cohort-year">2025/2026</span>
                        </div>
                        <div class="cohort-stats">
                            <div class="stat-item">
                                <i class="fas fa-users"></i>
                                <span class="stat-number">29</span>
                                <span class="stat-label">Students</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-building"></i>
                                <span class="stat-number">30</span>
                                <span class="stat-label">Companies</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-user-tie"></i>
                                <span class="stat-number">5</span>
                                <span class="stat-label">Supervisors</span>
                            </div>
                        </div>
                        <div class="cohort-details">
                            <p><strong>Duration:</strong> [TBA]</p>
                            <p><strong>Status:</strong> Planning Phase</p>
                        </div>
                        <a href="#" class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;">Coming Soon</a>
                    </div>

                </div>
            </section>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">
        <div class="container footer-content">
            <div class="footer-links">
                <a href="#">University</a> | 
