                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">PG Program <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="pg-info.html">Program Info</a></li>
                            <li><a href="pg-curriculum.html">Curriculum</a></li>
                            <li><a href="pg-admission.html">Admission</a></li>
