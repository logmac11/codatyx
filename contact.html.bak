    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- ================= HEADER & NAVIGATION ================= -->
    <header class="main-header">
        <div class="top-bar">
            <div class="container header-flex">
                <div class="logo-area">
                    <a href="https://www.uthm.edu.my/" target="_blank" rel="noopener noreferrer">
						<img src="uthmlogo.png" alt="UTHM Logo" class="logo">
					</a>
                    <div class="logo-text">
                        <!--<span class="uni-name">Universiti Tun Hussein Onn Malaysia</span>
                        <span class="dept-name">BSc. Computational Data Analytics</span> -->
                    </div>
                </div>
                <div class="search-area">
                    <input type="text" placeholder="Search...">
                    <button><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
        
        <nav class="main-nav">
            <div class="container">
                <ul class="nav-links">
                    <li><a href="index.html">Home</a></li>
                    
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">UG Program <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="ug-info.html">Program Info</a></li>
                            <li><a href="ug-curriculum.html">Curriculum</a></li>
                            <li><a href="ug-admission.html">Admission</a></li>
                        </ul>
                    </li>
                    
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">PG Program <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="pg-info.html">Program Info</a></li>
                            <li><a href="pg-curriculum.html">Curriculum</a></li>
                            <li><a href="pg-admission.html">Admission</a></li>
                        </ul>
                    </li>
                    
                    <li><a href="staff.html">Staff</a></li>
                    
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">WBL Info <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="wbl-info.html">About WBL</a></li>
                            <li><a href="wbl-courses.html">WBL Courses</a></li>
                            <li><a href="wbl-administration.html">WBL Administration</a></li>
                            <li><a href="wbl-cohorts.html">WBL Cohorts</a></li>
                            <!-- <li><a href="#">Industry Partners</a></li>
                            <li><a href="#">Student Testimonials</a></li> -->
                        </ul>
                    </li>
                    
                    <li><a href="contact.html" class="active">Contact</a></li>
                    <li class="apply-btn"><a href="apply.html">Apply Now</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- ================= PAGE HERO BANNER ================= -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="breadcrumb">
                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>Contact Us</span>
            </div>
            <h1>Contact Us</h1>
            <p>Get in touch with the BSc. Computational Data Analytics program</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">

            <!-- Info Banner -->
            <section class="section contact-info-banner">
                <div class="info-banner">
                    <div class="info-banner-icon">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>
                    <div class="info-banner-content">
                        <h3>Prefer to Email Directly?</h3>
                        <p>Visitors may personally email any academic staff member listed in our <a href="staff.html"><strong>Staff Section</strong></a> for specific academic enquiries, research collaboration, or course-related questions. Each staff profile includes their direct email address and research interests.</p>
                    </div>
                    <a href="staff.html" class="info-banner-btn">
                        <i class="fas fa-users"></i> View Staff
                    </a>
                </div>
            </section>

            <!-- Contact Info Cards -->
            <section class="section contact-info-section">
                <div class="section-header">
                    <span class="section-tag">Reach Us</span>
                    <h2>Program Contact Information</h2>
                    <div class="title-underline"></div>
                </div>
                
                <div class="contact-cards-grid">
                    <div class="contact-info-card">
                        <div class="contact-icon">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <h4>Head of Program</h4>
                        <p class="contact-name">Ts. Dr. Wan Nor Munirah Binti Ariffin</p>
                        <p><i class="fas fa-envelope"></i> <a href="mailto:normunirah@uthm.edu.my">normunirah@uthm.edu.my</a></p>
                        <p><i class="fas fa-phone"></i> 07-950 9176</p>
                    </div>
                    
                    <div class="contact-info-card">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <h4>Office Address</h4>
                        <p>Department of Mathematics and Statistics<br>
                        Faculty of Applied Sciences and Technology<br>
                        Universiti Tun Hussein Onn Malaysia<br>
                        86400 Parit Raja, Batu Pahat, Johor</p>
                    </div>
                    
                    <div class="contact-info-card">
                        <div class="contact-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h4>Office Hours</h4>
                        <p><strong>Sunday - Thursday:</strong><br>8:00 AM - 5:00 PM</p>
                        <p><strong>Friday - Saturday:</strong><br>Closed</p>
                        <p class="note-text">*Closed on public holidays</p>
                    </div>
                    
                    <div class="contact-info-card">
                        <div class="contact-icon">
                            <i class="fas fa-reply"></i>
                        </div>
                        <h4>Response Time</h4>
                        <p>We aim to respond to all enquiries within <strong>2-3 working days</strong>. For urgent matters, please call the office directly during working hours.</p>
                    </div>
                </div>
            </section>

            <!-- Contact Form Section -->
            <section class="section contact-form-section">
                <div class="contact-form-wrapper">
                    <div class="form-header">
                        <div class="form-header-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <h2>Send Us a Message</h2>
                        <p>Have a question, feedback, or enquiry? Fill out the form below and your message will be sent directly to the Head of Program for further action.</p>
                        <div class="form-note">
                            <i class="fas fa-info-circle"></i>
                            <span>All enquiries are handled by <strong>Ts. Dr. Wan Nor Munirah Binti Ariffin</strong> (Head of Program)</span>
                        </div>
                    </div>
                    
                    <form class="contact-form" action="mailto:normunirah@uthm.edu.my" method="post" enctype="text/plain">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name"><i class="fas fa-user"></i> Full Name <span class="required">*</span></label>
                                <input type="text" id="name" name="name" required placeholder="Enter your full name">
                            </div>
                            <div class="form-group">
                                <label for="email"><i class="fas fa-envelope"></i> Email Address <span class="required">*</span></label>
                                <input type="email" id="email" name="email" required placeholder="your.email@example.com">
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="phone"><i class="fas fa-phone"></i> Phone Number</label>
                                <input type="tel" id="phone" name="phone" placeholder="+60 12-345 6789">
                            </div>
                            <div class="form-group">
                                <label for="category"><i class="fas fa-tag"></i> Enquiry Category <span class="required">*</span></label>
                                <select id="category" name="category" required>
                                    <option value="">-- Select a category --</option>
                                    <option value="General Enquiry">General Enquiry</option>
                                    <option value="Admission">Admission</option>
                                    <option value="Curriculum">Curriculum</option>
                                    <option value="WBL">WBL Experience</option>
                                    <option value="Industry Partnership">Industry Partnership</option>
                                    <option value="Research Collaboration">Research Collaboration</option>
                                    <option value="Feedback">Feedback</option>
                                    <option value="Complaint">Complaint</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label for="subject"><i class="fas fa-heading"></i> Subject <span class="required">*</span></label>
                            <input type="text" id="subject" name="subject" required placeholder="Brief subject of your message">
                        </div>
                        
                        <div class="form-group">
                            <label for="message"><i class="fas fa-comment-dots"></i> Message <span class="required">*</span></label>
                            <textarea id="message" name="message" rows="6" required placeholder="Please provide details of your enquiry, feedback, or message..."></textarea>
                            <span class="char-count">Minimum 20 characters</span>
                        </div>
                        
                        <div class="form-group checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" required>
                                <span>I agree to the <a href="#">privacy policy</a> and consent to my data being processed for the purpose of responding to my enquiry. <span class="required">*</span></span>
                            </label>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Send Message
                            </button>
                            <button type="reset" class="btn btn-outline">
                                <i class="fas fa-redo"></i> Clear Form
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- Map Section -->
            <section class="section map-section">
                <div class="section-header">
                    <span class="section-tag">Location</span>
                    <h2>Find Us</h2>
                    <div class="title-underline"></div>
                </div>
                
                <div class="map-wrapper">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.123456789!2d103.0945!3d1.8617!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMcKwNTEnNDIuMSJOIDEwM8KwMDUnNDAuMiJF!5e0!3m2!1sen!2smy!4v1234567890" 
                        width="100%" 
                        height="400" 
                        style="border:0; border-radius: 12px;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
                
                <div class="directions-info">
                    <div class="direction-item">
                        <i class="fas fa-car"></i>
                        <div>
                            <h4>By Car</h4>
                            <p>From Batu Pahat town centre, take Jalan Parit Raja (Route 5) for approximately 25km. UTHM main campus entrance is on the right.</p>
                        </div>
                    </div>
                    <div class="direction-item">
                        <i class="fas fa-bus"></i>
                        <div>
                            <h4>By Public Transport</h4>
                            <p>Bus services available from Batu Pahat Bus Terminal to Parit Raja. Campus shuttle available from Parit Raja town.</p>
                        </div>
                    </div>
                    <div class="direction-item">
                        <i class="fas fa-plane"></i>
                        <div>
                            <h4>By Air</h4>
                            <p>Nearest airport: Senai International Airport (Johor Bahru), approximately 60km from campus. Taxi/Grab services available.</p>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">
        <div class="container footer-content">
            <div class="footer-links">
                <a href="#">University</a> | 
                <a href="#">About CDA</a> | 
                <a href="#">WBL</a> | 
                <a href="#">Faculty</a> | 
                <a href="#">Alumni</a> | 
                <a href="#">Contact</a>
            </div>
            <div class="footer-social">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
            </div>
            <div class="footer-copy">
                &copy; 2026 Universiti Tun Hussein Onn Malaysia | Faculty of Computer Science
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // Mobile Dropdown Toggle
        const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
        dropdownToggles.forEach(toggle => {
            toggle.addEventListener('click', (e) => {
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    const menu = toggle.nextElementSibling;
                    if (menu && menu.classList.contains('dropdown-menu')) {
                        menu.classList.toggle('show');
                    }
                }
            });
        });

        // Form validation enhancement
        const contactForm = document.querySelector('.contact-form');
        if (contactForm) {
            contactForm.addEventListener('submit', function(e) {
                const message = document.getElementById('message').value;
                if (message.length < 20) {
                    e.preventDefault();
                    alert('Please provide a more detailed message (minimum 20 characters).');
                    return false;
                }
                
                // Show confirmation
                alert('Thank you for your message! Your email client will open to send this enquiry to the Head of Program.');
            });
        }
    </script>

</body>
</html>