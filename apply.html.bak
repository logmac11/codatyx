    <!-- ================= PAGE HERO BANNER ================= -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="breadcrumb">
                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>Apply Now</span>
            </div>
            <h1>Begin Your Journey</h1>
            <p>Take the first step towards a rewarding career in Computational Data Analytics</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">

            <!-- Application Options -->
            <section class="section apply-section">
                <div class="section-header">
                    <span class="section-tag">Admissions</span>
                    <h2>Choose Your Application Pathway</h2>
                    <div class="title-underline"></div>
                    <p class="section-subtitle">Select the appropriate application portal based on your current academic qualification and the program level you wish to pursue.</p>
                </div>
                
                <div class="apply-cards-grid">
                    
                    <!-- Undergraduate Card -->
                    <div class="apply-card ug-card">
                        <div class="apply-card-header">
                            <div class="apply-icon">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <h3>Undergraduate Program</h3>
                            <span class="program-badge ug">BSc. Computational Data Analytics</span>
                        </div>
                        <div class="apply-card-body">
                            <p>This 2u2i Work-Based Learning (WBL) program is designed for students who have completed their pre-university qualifications (e.g., STPM, Matriculation, Foundation, or Diploma) and wish to pursue a Bachelor's degree with extensive industry experience.</p>
                            
                            <ul class="apply-requirements">
                                <li><i class="fas fa-check-circle"></i> Duration: 3.5 Years (7 Semesters + 1 Short Sem)</li>
                                <li><i class="fas fa-check-circle"></i> Mode: 2.5 Years University + 1 Year Industry</li>
                                <li><i class="fas fa-check-circle"></i> Intake: September annually</li>
                            </ul>
                        </div>
                        <div class="apply-card-footer">
                            <a href="https://upu.mohe.gov.my/" target="_blank" rel="noopener noreferrer" class="btn btn-primary apply-btn-large">
                                <i class="fas fa-external-link-alt"></i> Apply via UPU
                            </a>
                            <p class="apply-note"><i class="fas fa-info-circle"></i> For Malaysian citizens applying through the centralized UPU system.</p>
                        </div>
                    </div>

                    <!-- Postgraduate Card -->
                    <div class="apply-card pg-card">
                        <div class="apply-card-header">
                            <div class="apply-icon">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                            <h3>Postgraduate Program</h3>
                            <div class="pg-badges-group">
								<span class="program-badge pg">Master of Data Analytics (Coursework)</span>
								<span class="program-badge pg">Master of Science (Research)</span>
								<span class="program-badge pg">Doctor of Philosophy in Science (Research)</span>
							</div>
                        </div>
                        <div class="apply-card-body">
                            <p>Designed for graduates and working professionals seeking to advance their expertise in data science, machine learning, and big data analytics through advanced coursework and research components.</p>
                            
                            <ul class="apply-requirements">
                                <li><i class="fas fa-check-circle"></i> Duration: 1 - 4 Years (Full-time / Part-time)</li>
                                <li><i class="fas fa-check-circle"></i> Mode: Coursework & Research</li>
                                <li><i class="fas fa-check-circle"></i> Intake: February & September annually</li>
                            </ul>
                        </div>
                        <div class="apply-card-footer">
                            <a href="https://wapps.uthm.edu.my/intake/" target="_blank" rel="noopener noreferrer" class="btn btn-primary apply-btn-large">
                                <i class="fas fa-external-link-alt"></i> Apply via UTHM Intake
                            </a>
                            <p class="apply-note"><i class="fas fa-info-circle"></i> Direct application through the UTHM Postgraduate Intake portal.</p>
                        </div>
                    </div>

                </div>
            </section>

            <!-- Additional Help Section -->
            <section class="section help-section">
                <div class="help-box">
                    <div class="help-icon">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div class="help-content">
                        <h3>Need Assistance with Your Application?</h3>
                        <p>If you have questions regarding entry requirements, document submission, or the application process, our admissions team is here to help.</p>
                    </div>
                    <a href="contact.html" class="btn btn-outline">Contact Admissions</a>
                </div
            </section>

        </div>
    </main>

