                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>UG Program</span> <i class="fas fa-chevron-right"></i> 
                <span>Admission</span>
            </div>
            <h1>Admission Requirements</h1>
            <p>Bachelor of Science (Computational Data Analytics) with Honours</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">

            <!-- Program Badge -->
            <div class="program-badge">
                <span class="badge ug">Undergraduate</span>
                <span class="badge mode">2u2i Work-Based Learning</span>
				<span class="badge intake">Intake: September/OCtober every year</span>
            </div>

            <!-- 5. SPECIFIC PROGRAM ADMISSION REQUIREMENTS -->
            <section class="section admission-section">
                <div class="section-header">
                    <span class="section-tag">Requirements</span>
                    <h2>Specific Program Admission Requirements (FOR MALAYSIAN)</h2>
                    <div class="title-underline"></div>
                    <p class="section-subtitle">Candidates must meet the academic and English language requirements based on their qualification stream.</p>
                </div>
                
                <div class="table-responsive">
                    <table class="admission-table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">Category</th>
                                <th style="width: 40%;">Academic Requirements</th>
                                <th style="width: 20%;">MUET Requirements</th>
                                <th style="width: 20%;">Additional Requirements</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- STPM Science Stream -->
                            <tr>
                                <td><strong>STPM Applicants<br>(Science Stream)</strong></td>
                                <td>
                                    Obtained at least <strong>Grade C (GP 2.00)</strong> at the STPM level in the following subjects:<br><br>
                                    • Mathematics (T)<br><br>
                                    <strong>AND</strong><br><br>
                                    • Physics / Chemistry / Biology / Information and Communications Technology
                                </td>
                                <td>Obtained at least <strong>Band 2.0</strong> in the Malaysian University English Test (MUET), within the validity period at the time of application.</td>
                                <!-- ROWSPAN MUST BE IN THE FIRST ROW -->
                                <td rowspan="5" class="additional-req">
                                    <i class="fas fa-exclamation-circle"></i><br><br>
                                    Candidates <strong>MUST NOT</strong> have physical disabilities that hinder practical work.
                                </td>
                            </tr>
                            
                            <!-- STPM Arts Stream -->
                            <tr>
                                <td><strong>STPM Applicants<br>(Arts Stream)</strong></td>
                                <td>
                                    • Obtained at least <strong>Grade B (GP 3.00)</strong> at the STPM level in the following subjects:<br><br>
                                    Mathematics (M) / Business Studies / Economics / Accounting / History / Geography / Sports Science<br><br>
                                    <strong>AND</strong><br><br>
                                    • Obtained at least <strong>Grade C (Credit)</strong> in Mathematics at the SPM level.
                                </td>
                                <td>Obtained at least <strong>Band 2.0</strong> in the Malaysian University English Test (MUET), within the validity period at the time of application.</td>
                            </tr>
                            
                            <!-- STAM -->
                            <tr>
                                <td><strong>STAM Applicants</strong></td>
                                <td>
                                    • Possess a Sijil Tinggi Agama Malaysia (STAM) with at least a <strong>Jayyid (Good)</strong> rank.<br><br>
                                    <strong>AND</strong><br><br>
                                    • Obtained at least <strong>Grade C (Credit)</strong> at the SPM level in any <strong>one (1)</strong> of the following subjects:<br><br>
                                    Mathematics / Computer Science
                                </td>
                                <td>Obtained at least <strong>Band 1.0</strong> in the Malaysian University English Test (MUET), within the validity period at the time of application.</td>
                            </tr>
                            
                            <!-- Matriculation/Foundation -->
                            <tr>
                                <td><strong>Matriculation /<br>Foundation Applicants</strong></td>
                                <td>
                                    Obtained at least <strong>Grade C (GP 2.00)</strong> at the Matriculation/Foundation level in:<br><br>
                                    • Mathematics<br><br>
                                    <strong>OR</strong><br><br>
                                    • Statistics and Data Analysis / Programming and Computer / Discrete Mathematics and Logic / Analytics and Data Science / Quantitative Support Course / Business Foundation Course
                                </td>
                                <td>Obtained at least <strong>Band 2.0</strong> in the Malaysian University English Test (MUET), within the validity period at the time of application.</td>
                            </tr>
                            
                            <!-- Diploma -->
                            <tr>
                                <td><strong>Diploma Applicants</strong></td>
                                <td>
                                    • Possess a Diploma in Mathematics / Science / Statistics / Actuarial Science / Applied Science / Mathematical Science / Accounting / Investment Analysis / Computer Science / Information Technology from any Public University (UA), Polytechnic, or an equivalent qualification recognized by the Government of Malaysia, with a minimum <strong>CPA / CGPA of 2.50</strong>.<br><br>
                                    • <strong>Note:</strong> Candidates with a <strong>CPA / CGPA below 2.50 but above 2.00</strong> may be accepted subject to a rigorous internal assessment process and must complete a bridging program if required by UTHM.
                                </td>
                                <td>
                                    Obtained at least <strong>Band 2.0</strong> in the Malaysian University English Test (MUET) within the validity period.<br><br>
                                    <em style="font-size: 0.85rem; color: var(--text-muted);">(MUET exemption as an entry requirement to the Malaysia Technical University Network (MTUN) is granted to Diploma graduates from Polytechnics and Community Colleges).</em>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- How to Apply Section -->
            <section class="section apply-steps-section">
                <div class="section-header">
                    <span class="section-tag">Process</span>
                    <h2>How to Apply</h2>
                    <div class="title-underline"></div>
                </div>
                <div class="steps-grid">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h4>Check Eligibility</h4>
                        <p>Ensure you meet the specific academic and MUET requirements listed above for your qualification stream.</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h4>Prepare Documents</h4>
                        <p>Gather your academic transcripts, MUET results, IC/Passport copy, and a recent passport-sized photograph.</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h4>Submit Application</h4>
                        <p>Apply online through the UTHM official admission portal or via UPU for Malaysian citizens.</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">4</div>
                        <h4>Offer & Acceptance</h4>
                        <p>Receive your offer letter, accept the offer within the stipulated time, and complete the registration process.</p>
                    </div>
                </div>
                <div style="text-align: center; margin-top: 40px;">
                    <a href="#" class="btn btn-primary"><i class="fas fa-external-link-alt"></i> Visit UTHM Admission Portal</a>
                </div>
            </section>

        </div>
    </main>

