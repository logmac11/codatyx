    <!-- ================= PAGE HERO BANNER ================= -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="breadcrumb">
                <a href="index.html">Home</a> <i class="fas fa-chevron-right"></i> 
                <span>UG Program</span> <i class="fas fa-chevron-right"></i> 
                <span>Program Info</span>
            </div>
            <h1>BSc. Computational Data Analytics</h1>
            <p>Bachelor of Science (Computational Data Analytics) with Honours</p>
        </div>
    </section>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="container">

            <!-- Program Badge -->
            <div class="program-badge">
                <span class="badge ug">Undergraduate</span>
                <span class="badge mode">2u2i Work-Based Learning</span>
				<span class="badge intake">Intake: September/October every year</span>
				
            </div>

            <!-- 1. PROGRAM SYNOPSIS -->
            <section class="section synopsis-section">
                <div class="section-header">
                    <span class="section-tag">Overview</span>
                    <h2>Program Synopsis</h2>
                    <div class="title-underline"></div>
                </div>
                <div class="synopsis-content">
                    <div class="synopsis-text">
                        <p>The <strong>Bachelor of Science (Computational Data Analytics) with Honours</strong> is offered as a <span class="highlight">2u2i program</span> in direct response to the nation's higher education aspirations—specifically, to produce holistic, entrepreneurial, and balanced graduates (Shift 1, Malaysia Education Blueprint). By co-developing the curriculum alongside industry experts, the program ensures a seamless match between graduate capabilities and current market demands.</p>
                        <p>This initiative enhances the student learning experience through expanded industry collaboration in both curriculum design and program delivery. By integrating <span class="highlight">Work-Based Learning (WBL)</span> and experiential learning, the program equips students with essential 21st-century skills while leveraging technological advancements to deliver a highly personalized learning journey.</p>
                    </div>
                    <div class="synopsis-visual">
                        <div class="visual-card">
                            <i class="fas fa-graduation-cap"></i>
                            <span>2u2i Mode</span>
                        </div>
                        <div class="visual-card">
                            <i class="fas fa-industry"></i>
                            <span>Industry Co-Developed</span>
                        </div>
                        <div class="visual-card">
                            <i class="fas fa-briefcase"></i>
                            <span>WBL Integrated</span>
                        </div>
                        <div class="visual-card">
                            <i class="fas fa-rocket"></i>
                            <span>21st Century Skills</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. PROGRAM EDUCATIONAL OBJECTIVES (PEO) -->
            <section class="section peo-section">
                <div class="section-header">
                    <span class="section-tag">Goals</span>
                    <h2>Program Educational Objectives (PEO)</h2>
                    <div class="title-underline"></div>
                </div>
                <div class="peo-grid">
                    <div class="peo-card">
                        <div class="peo-number">01</div>
                        <div class="peo-icon"><i class="fas fa-lightbulb"></i></div>
                        <h3>Competent & Innovative</h3>
                        <p>Competent and innovative in providing sustainable solutions using data analytics and technology to fulfil the needs of the organisation.</p>
                    </div>
                    <div class="peo-card">
                        <div class="peo-number">02</div>
                        <div class="peo-icon"><i class="fas fa-book-reader"></i></div>
                        <h3>Continuous Learning</h3>
                        <p>Continuously self-updating and contributing knowledge to the betterment of society.</p>
                    </div>
                    <div class="peo-card">
                        <div class="peo-number">03</div>
                        <div class="peo-icon"><i class="fas fa-users"></i></div>
                        <h3>Ethical Professional</h3>
                        <p>Contribute as a key member in any organisation and practice high ethics and professionalism.</p>
                    </div>
                </div>
            </section>

            <!-- 3. PROGRAM LEARNING OUTCOMES (PLO) -->
            <section class="section plo-section">
                <div class="section-header">
                    <span class="section-tag">Outcomes</span>
                    <h2>Program Learning Outcomes (PLO)</h2>
                    <div class="title-underline"></div>
                    <p class="section-subtitle">Upon completion of the program, graduates will be able to:</p>
                </div>
                <div class="plo-grid">
                    <div class="plo-item">
                        <div class="plo-badge">PLO 1</div>
                        <p>Demonstrate technical knowledge and skills in both computer science and statistical modeling for data-intensive problem solving.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 2</div>
                        <p>Apply critical, analytical and systematic evaluation skills to design and implement efficient, data-driven solutions.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 3</div>
                        <p>Perform practical and technical skills in Computational Data Analytics and modern data analytics methods.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 4</div>
                        <p>Exhibit good relationships, interact with others and work effectively in fulfilling individual and group tasks.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 5</div>
                        <p>Communicate and convey information effectively in both written and verbal forms.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 6</div>
                        <p>Use a broad range of information and media technologies to support the learning process.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 7</div>
                        <p>Analyze data based on numerical and visualization skills to support decision making.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 8</div>
                        <p>Demonstrate decision-making professionally, autonomously and responsibly in managerial capacities.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 9</div>
                        <p>Engage in continuous enhancement of knowledge in the field of data analytics and related disciplines.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 10</div>
                        <p>Initiate a plan of self-driven entrepreneurship.</p>
                    </div>
                    <div class="plo-item">
                        <div class="plo-badge">PLO 11</div>
                        <p>Make decisions ethically and act professionally within various social and professional environments.</p>
                    </div>
                </div>
            </section>

            <!-- 4. PROGRAM STRUCTURE & DURATION -->
            <section class="section structure-section">
                <div class="section-header">
                    <span class="section-tag">Details</span>
                    <h2>Program Structure & Duration</h2>
                    <div class="title-underline"></div>
                </div>
                <div class="structure-table-wrapper">
                    <table class="structure-table">
                        <thead>
                            <tr>
                                <th>Component</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="fas fa-exchange-alt"></i> Mode of Study</td>
                                <td><strong>2u2i Mode</strong> (2.5 years in university, 1 year in industry / Work-Based Learning)</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-credit-card"></i> Total Credit Hours</td>
                                <td><strong>120 Credit Hours</strong></td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-clock"></i> Minimum Duration</td>
                                <td><strong>3.5 Years</strong> (7 Long Semesters, 1 Short Semester)</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-hourglass-end"></i> Maximum Duration</td>
                                <td><strong>7 Years</strong> (14 Long Semesters, 4 Short Semesters)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- 5. CAREER OPPORTUNITIES -->
            <section class="section career-section">
                <div class="section-header">
                    <span class="section-tag">Future</span>
                    <h2>Career Opportunities</h2>
                    <div class="title-underline"></div>
                    <p class="section-subtitle">Graduates are prepared for diverse roles in the data-driven economy</p>
                </div>
                <div class="career-grid">
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-chart-bar"></i></div>
                        <h4>Data Analyst</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-search"></i></div>
                        <h4>Data Mining Analyst</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-database"></i></div>
                        <h4>Big Data Analyst</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-bullhorn"></i></div>
                        <h4>Business & Marketing Analyst</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-robot"></i></div>
                        <h4>Machine Learning Engineer</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-server"></i></div>
                        <h4>Data Engineer</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-brain"></i></div>
                        <h4>Data Scientist</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-calculator"></i></div>
                        <h4>Statistician</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                        <h4>Academician</h4>
                    </div>
                    <div class="career-card">
                        <div class="career-icon"><i class="fas fa-microscope"></i></div>
                        <h4>Researcher</h4>
                    </div>
                    <div class="career-card featured">
                        <div class="career-icon"><i class="fas fa-chart-line"></i></div>
                        <h4>Data-Driven Decision Maker</h4>
                    </div>
                </div>
            </section>

        </div>
    </main>

